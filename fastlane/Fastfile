opt_out_usage

default_platform(:ios)

platform :ios do
  private_lane :asc_api_key do
    next nil unless ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"] && ENV["ASC_KEY_FILEPATH"]

    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"]
    )
  end

  private_lane :provisioning_xcargs do
    "-allowProvisioningUpdates"
  end

  desc "Build Månen for the iOS Simulator"
  lane :build_simulator do
    clear_derived_data(derived_data_path: "/tmp/MånenDerivedData")

    xcodebuild(
      project: "Fordybelse.xcodeproj",
      scheme: "Fordybelse",
      destination: "generic/platform=iOS Simulator",
      derivedDataPath: "/tmp/MånenDerivedData",
      configuration: "Debug",
      build: true
    )
  end

  desc "Clean local build artifacts"
  lane :clean do
    clear_derived_data(derived_data_path: "/tmp/MånenDerivedData")
  end

  desc "Prepare App Store distribution signing"
  lane :prepare_distribution_signing do
    api_key = asc_api_key

    cert(
      api_key: api_key,
      development: false,
      generate_apple_certs: true
    )

    sigh(
      api_key: api_key,
      app_identifier: "app.manen.mvp",
      platform: "ios"
    )
  end

  desc "Create a Release archive for distribution"
  lane :archive_release do
    gym(
      project: "Fordybelse.xcodeproj",
      scheme: "Fordybelse",
      configuration: "Release",
      clean: true,
      output_directory: "build",
      output_name: "Manen",
      export_method: "app-store",
      xcargs: provisioning_xcargs,
      skip_package_ipa: false
    )
  end

  desc "Upload a Release archive to TestFlight"
  lane :beta do
    api_key = asc_api_key
    archive_release
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload Månen to App Store Connect without submitting for review"
  lane :app_store do
    api_key = asc_api_key
    upload_to_app_store(
      api_key: api_key,
      ipa: "build/Manen.ipa",
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_metadata: true,
      skip_screenshots: true,
      run_precheck_before_submit: false
    )
  end

  desc "Upload localized App Store screenshots without uploading a new binary"
  lane :screenshots do
    api_key = asc_api_key
    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false
    )
  end
end
